        {
          "name": "Comprar Produtos (Pública)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": {\n    \"name\": \"Cliente Comprador\",\n    \"email\": \"comprador@teste.com\"\n  },\n  \"products\": [\n    {\n      \"id\": 1,\n      \"quantity\": 2\n    }\n  ],\n  \"credit_card\": {\n    \"number\": \"5569000000006063\",\n    \"holder_name\": \"Cliente Comprador\",\n    \"exp_month\": 12,\n    \"exp_year\": 2028,\n    \"cvv\": \"010\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": [ "{{base_url}}" ],
              "path": [ "transactions" ]
            }
          }
        },
        {
          "name": "Listar Transações (Privada)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{auth_token}}", "type": "string" } ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transactions",
              "host": [ "{{base_url}}" ],
              "path": [ "transactions" ]
            }
          }
        },
        {
          "name": "Detalhes Transação (Privada)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{auth_token}}", "type": "string" } ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transactions/1",
              "host": [ "{{base_url}}" ],
              "path": [ "transactions", "1" ]
            }
          }
        },
        {
          "name": "Estornar Transação (Privada)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{auth_token}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/transactions/1/refund",
              "host": [ "{{base_url}}" ],
              "path": [ "transactions", "1", "refund" ]
            }
          }
        }
      ]
    },
